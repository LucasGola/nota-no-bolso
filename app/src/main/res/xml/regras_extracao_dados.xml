<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup na nuvem e transferência para um aparelho novo levam só o banco. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
